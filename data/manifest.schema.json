{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sidvortex/OpenSource-SAR/data/manifest.schema.json",
  "title": "Open Source SAR place manifest",
  "description": "The contract between the pipeline and the web app: data/layers/<place>/manifest.json",
  "type": "object",
  "required": ["hotspot", "module", "title", "headline", "synthetic", "product", "bounds", "frame_noun", "layers", "stats", "chart", "method", "frames"],
  "properties": {
    "hotspot": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "module": {"enum": ["water", "ground", "fire", "farming", "ice"]},
    "title": {"type": "string", "minLength": 1},
    "headline": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "created": {"type": "string", "format": "date"},
    "product": {"type": "string"},
    "grid_res": {"type": "number", "exclusiveMinimum": 0},
    "bounds": {"type": "array", "minItems": 4, "maxItems": 4,
               "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
    "event": {"type": ["string", "null"]},
    "frame_noun": {"enum": ["passes", "pairs"]},
    "sides": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "compare": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
    "side_stat": {"$ref": "#/$defs/stat"},
    "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}},
    "stats": {"type": "array", "items": {"$ref": "#/$defs/stat"}},
    "chart": {"type": "object", "required": ["area", "label"],
              "properties": {"area": {"type": "string"}, "line": {"type": ["string", "null"]}, "label": {"type": "string"}}},
    "method": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}},
    "series": {"type": "object",
               "required": ["file", "count", "width", "height", "factor", "full_width", "full_height", "dates", "label", "unit"],
               "properties": {"count": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1},
                              "height": {"type": "integer", "minimum": 1}, "factor": {"type": "integer", "minimum": 1},
                              "dates": {"type": "array", "items": {"type": "string"}}}},
    "dance": {"type": "object", "required": ["dance", "confidence", "reason"],
              "properties": {"dance": {"enum": ["waltz", "march", "tango", "crescendo", "still"]},
                             "confidence": {"enum": ["high", "medium", "low"]}}},
    "validation": {"type": ["object", "null"]},
    "exposure": {"type": "object", "required": ["source", "synthetic"]},
    "bridged": {"type": "array"}
  },
  "$defs": {
    "stat": {"type": "object", "required": ["id", "label", "unit"],
             "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "unit": {"type": "string"}}},
    "layer": {"type": "object", "required": ["id", "label", "opacity"],
              "properties": {"id": {"type": "string"}, "label": {"type": "string"},
                             "opacity": {"type": "number", "minimum": 0, "maximum": 1},
                             "legend": {"type": "array", "items": {"type": "object", "required": ["label", "color"]}},
                             "ramp": {"type": "object", "required": ["colors", "min", "max", "unit", "low", "high"]}},
              "anyOf": [{"required": ["legend"]}, {"required": ["ramp"]}]},
    "frame": {"type": "object", "required": ["date", "label", "files", "stats", "sources"],
              "properties": {"date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                             "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                             "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
                             "stats": {"type": "object", "additionalProperties": {"type": "number"}},
                             "sources": {"type": "array", "items": {"type": "string"}}}}
  }
}
